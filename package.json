{
  "name": "@rwinfu/tryon",
  "version": "2.0.0",
  "description": "پرو مجازی عینک — افزونهٔ WebGL برای فروشگاه‌های اپتیک (MediaPipe + three.js، هندسهٔ رویه‌ای فریم)",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "keywords": [
    "virtual-try-on",
    "eyewear",
    "optical",
    "threejs",
    "mediapipe",
    "shopify",
    "woocommerce",
    "glb"
  ],
  "main": "src/plugin.js",
  "module": "src/plugin.js",
  "exports": {
    ".": "./src/plugin.js",
    "./frame": "./src/frame/index.js",
    "./catalog": "./src/frame/catalog.js",
    "./dist/tryon.js": "./dist/tryon.js",
    "./dist/tryon.esm.js": "./dist/tryon.esm.js"
  },
  "files": [
    "src",
    "dist",
    "lib",
    "assets",
    "products.json",
    "studio.html",
    "docs",
    "MODEL-LICENSES.txt",
    "README.md"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/serve.mjs",
    "bake": "node tools/bake.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "size": "node tools/size-report.mjs",
    "preview": "node tools/preview.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "three": "0.169.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/extensions": "^4.4.1",
    "@playwright/test": "^1.58.2",
    "esbuild": "^0.25.12",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
